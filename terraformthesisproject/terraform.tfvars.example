# terraform.tfvars.example
#
# Copy this file to terraform.tfvars (already gitignored) and fill in real
# values. Never commit terraform.tfvars itself.

aws_region       = "us-east-1"
project_name     = "Thesis-Project"

# Find your public IP with: curl ifconfig.me
allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"

# Use a strong, unique password - this is only ever read from here or from
# the TF_VAR_db_password environment variable, never hardcoded in .tf files.
db_password      = "REPLACE-WITH-A-STRONG-PASSWORD"
